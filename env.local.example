# ─── API Keys ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...
GROQ_API_KEY=gsk_...

# ─── Model Selection (optional — defaults shown) ─────────────────────────────
OPENAI_MODEL=gpt-6-luna
GEMINI_MODEL=gemini-3-flash-preview
GROQ_MODEL=openai/gpt-oss-120b

# ─── Smart Routing Tier → Provider Mapping ──────────────────────────────────
# Which provider handles each complexity tier (must be: openai | gemini | groq)
TIER_HARD=openai
TIER_MEDIUM=gemini
TIER_SIMPLE=groq

# ─── Per-Provider Token-Per-Minute Budget (optional — defaults shown) ────────
# Lower these to test the quota fallback feature with real traffic
OPENAI_MAX_TPM=200000
GEMINI_MAX_TPM=1000000
GROQ_MAX_TPM=30000

# ─── Priority Mode ────────────────────────────────────────────────────────────
# FORCED_PRIORITY=true  → skip complexity classifier, always use PRIORITY_ORDER
# FORCED_PRIORITY=false → use the hard/medium/simple smart classifier
FORCED_PRIORITY=true
PRIORITY_ORDER=openai,groq,gemini

# ─── Failover Strategy ────────────────────────────────────────────────────────
# FAILOVER_BEFORE_RETRY=true  - skip immediately to next provider on any error (default)
# FAILOVER_BEFORE_RETRY=false - retry the same provider once before falling over
FAILOVER_BEFORE_RETRY=true

# ─── Compression Mode ─────────────────────────────────────────────────────────
# off  - disabled, pass messages through unchanged
# lite - always compress (whitespace + history collapse)
# auto - compress only when request exceeds 2,000 tokens (default)
COMPRESSION_MODE=auto

# ─── Caveman Linguistic Compression ──────────────────────────────────────────
# CAVEMAN_COMPRESSION=false → disable (default: enabled when lite/auto mode runs)
# Strips filler phrases, hedging, pleasantries, and verbose reformulations.
# Also deduplicates consecutive identical lines in long tool/log output (RTK pass).
# Never modifies system prompts or code blocks.
CAVEMAN_COMPRESSION=true

# ─── Guardrails ───────────────────────────────────────────────────────────────
# GUARDRAILS_ENABLED=false  → disable all guardrails (default: enabled)
# GUARDRAIL_DISABLED_RULES  → comma-separated rule IDs to skip (e.g. email,phone-e164)
GUARDRAILS_ENABLED=true
GUARDRAIL_DISABLED_RULES=